{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Weather Server (SSE)",
            "type": "debugpy",
            "request": "launch",
            "module": "servers.weather_server",
            "args": [
                "--transport",
                "sse",
                "--port",
                "8000"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug Weather Server (STDIO)",
            "type": "debugpy",
            "request": "launch",
            "module": "servers.weather_server",
            "args": [
                "--transport",
                "stdio"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug test_weather.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_weather.py",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug test_wether_sse.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_wether_sse.py",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug Calculator Server (SSE)",
            "type": "debugpy",
            "request": "launch",
            "module": "servers.calculator_server",
            "args": [
                "--transport",
                "sse",
                "--port",
                "8001"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
    ],
    "compounds": [
        {
            "name": "Debug Weather Client & Server (SSE)",
            "configurations": [
                "Debug Weather Server (SSE)",
                "Debug test_wether_sse.py"
            ],
            "stopAll": true,
            "presentation": {
                "hidden": false,
                "group": "",
                "order": 2
            }
        }
    ]
}